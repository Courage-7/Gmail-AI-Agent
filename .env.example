APP_NAME=email-assistant-app
ENVIRONMENT=local
LOG_LEVEL=INFO

# LLM.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Supabase conversation memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DEFAULT_USER_ID=local-user

# Docker Gmail MCP smoke-test configuration.
# EMAIL_PASSWORD must be a Gmail App Password, not the normal account password.
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your_16_character_gmail_app_password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_MCP_IMAGE=yashtekwani/gmail-mcp
TEST_SEND_TO=your-email@gmail.com
